# ── OpenRouter LLM setup ─────────────────────────────────────────
# OpenRouter is a gateway that lets this project call many model providers with one API key.
# Create a key here: https://openrouter.ai/keys
#
# Keep the real key in `.env`, never in `.env.example`, and never commit `.env` to Git.
OPENROUTER_API_KEY=""

# OpenRouter is compatible with the OpenAI Python SDK when this base URL is set.
# You should not need to change this unless OpenRouter changes its API endpoint.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Pick the model used to draft reviews.
# Browse current model slugs here: https://openrouter.ai/models
#
# Good starter choices to try:
#   openai/gpt-4o-mini                  # fast, cheaper, good enough for early testing
#   openai/gpt-4o                       # stronger writing, usually more expensive
#   anthropic/claude-sonnet-4.5         # strong prose/style following if available to your account
#   google/gemini-2.0-flash-001         # fast alternative
#
# Use the OpenRouter slug only; do not prefix it with "openrouter:" in this project.
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Optional attribution headers.
# OpenRouter uses these to label traffic in its dashboard/rankings.
# For a private local script, placeholders are fine.
OPENROUTER_SITE_URL="http://localhost"
OPENROUTER_APP_NAME="letterboxd-auto-review"

# ── Drafting behavior ────────────────────────────────────────────
# Number of past reviews to include as style examples.
# More examples can improve style matching, but also cost more and may dilute the prompt.
REVIEW_EXAMPLE_COUNT="5"

# Controls randomness. Lower is more consistent; higher is more varied.
# For writing in your own voice, start around 0.6-0.8.
LLM_TEMPERATURE="0.7"

# Optional cap on output size. Empty means the model/provider default is used.
# If drafts are getting too long, try something like 1200.
LLM_MAX_TOKENS=""

# ── Optional direct OpenAI fallback ───────────────────────────────
# This project defaults to OpenRouter. These are here only in case you later want
# to bypass OpenRouter and call OpenAI directly.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

